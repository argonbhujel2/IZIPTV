# ═══════════════════════════════════════════════════════════
# IZ_IPTV Environment Variables
# Copy to admin-web/.env.local for local development
# Set in Vercel Project Settings for production
# ═══════════════════════════════════════════════════════════

# Neon PostgreSQL (from Neon console)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/iz_iptv?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/iz_iptv?sslmode=require"

# JWT secrets — generate strong random values (min 32 chars)
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
ADMIN_SESSION_SECRET="change-me-to-another-long-random-string"

# CORS (set to your admin domain in production)
CORS_ORIGIN="*"

# Optional: Object storage for images (S3-compatible / Cloudflare R2 / etc.)
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# CDN_BASE_URL=

# Node
NODE_ENV=development
